<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required: the SDK downloads map data -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required: the SDK uses it to detect connectivity. Without it the SDK assumes it is offline -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The SDK needs no location, Bluetooth or boot permissions. Add those only if your own
         positioning provider needs them (none of these samples do) -->

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
